# Postgres from docker-compose.yml
DATABASE_URL=postgres://qahub:qahub-local@localhost:5433/qahub

# Encrypts the session cookie. At least 32 characters; change it for anything but local use.
SESSION_SECRET=local-only-session-secret-change-me-32+

# Every seeded user (admin@qahub.test, editor@qahub.test, viewer@qahub.test) gets this password
SEED_PASSWORD=QaHub!2026

# Where the QA suite and the platform live (paths relative to this folder work)
QA_REPO_PATH=../rentacar-qa-automation
PLATFORM_REPO_PATH=../rentacar-platform
# The Python of the QA suite; empty means <QA_REPO_PATH>/.venv/Scripts/python.exe (Windows) or .venv/bin/python
QA_PYTHON=
PLATFORM_URL=http://localhost:8000
PLATFORM_GITHUB_URL=https://github.com/arditgashii/rentacar-platform

# Public URL of this app, used in links inside Teams messages
APP_URL=http://localhost:3000

# Only for local checks: lets a Teams channel point to the mock receiver (npm run teams:mock)
TEAMS_ALLOW_LOCAL_WEBHOOK=1

# Manual Regression: Jira keys like DN-1234 become links to this base URL
JIRA_BASE_URL=https://jira.example.com/browse/
JIRA_PROJECT_KEY=DN

# Days the videos, screenshots and traces of a run are kept
MEDIA_RETENTION_DAYS=14
